{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "biome": true,
  "lefthook": true,
  "ignoreDependencies": ["@biomejs/biome", "lefthook", "tailwindcss"],
  "ignoreBinaries": ["vite", "tsc", "biome", "knip"],
  "ignore": ["src/generated/**"],
  "entry": [
    "index.html!",
    "src/qr/index.ts!",
    "src/staff/index.ts!",
    "src/staff/kds/index.ts!",
    "src/staff/pos/index.ts!",
    "src/admin/orders/index.ts!",
    "src/admin/housekeeping/index.ts!",
    "src/admin/banquets/index.ts!",
    "src/admin/activities/index.ts!",
    "src/admin/inventory/index.ts!",
    "src/admin/hr/index.ts!",
    "src/admin/superadmin/index.ts!",
    "src/admin/layout/index.ts!",
    "test/**/*.test.ts"
  ],
  "project": ["src/**/*.{ts,tsx}!", "test/**/*.test.ts"]
}
